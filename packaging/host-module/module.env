# Static settings of the MFGraph module process: etc/module.env in the
# bundle, read with --config (see README.md). The host platform injects the
# values that differ per deployment as environment variables, which win
# over this file: MODULE_ID, MODULE_SOCKET, MODULE_INTERNAL_TOKEN,
# MFGRAPH_DSN, MFGRAPH_OPS_DSN, MFGRAPH_DATA_DIR and MFGRAPH_TENANT_ID.
# Format: KEY=VALUE per line; '#' starts a comment only at the beginning of
# a line; no quotes and no ${...} expansion.
MFGRAPH_MODE=module
MFGRAPH_TRUSTED_HEADER_PREFIX=X-Atf-
MFGRAPH_INTERNAL_TOKEN_HEADER=X-Atf-Internal-Token
MFGRAPH_ROUTE_PREFIX=/internal/v1/mfgraph
MFGRAPH_OUTBOX_TABLE=ops.module_outbox
MFGRAPH_KERNEL_MIGRATIONS=false
MFGRAPH_LOG_LEVEL=info
