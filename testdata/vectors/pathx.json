{
  "schema": "mfgraph-test-vectors/pathx/1",
  "review_status": "pending-human-review",
  "description": "Path grammar vectors. normalize: valid inputs give the canonical NFC output; invalid inputs give the error kind of the first failing rule (rule order: UTF-8/non-empty, absolute/backslash/control, NFC, empty/dot segments, segment and path byte limits). Lengths are counted in bytes of the NFC form. Inputs that cannot be written as JSON strings use input_hex. Long inputs use a generator: segments joined by '/', each segment = unit repeated `repeat` times, emitted `times` times (default 1).",
  "normalize": [
    {"name": "simple", "input": "a.txt", "output": "a.txt"},
    {"name": "nested", "input": "docs/specs/v1/format.md", "output": "docs/specs/v1/format.md"},
    {"name": "cafe-nfc", "input": "café.txt", "output": "café.txt"},
    {"name": "cafe-nfd-normalized", "input": "café.txt", "output": "café.txt"},
    {"name": "angstrom-sign-singleton", "input": "Å.txt", "output": "Å.txt"},
    {"name": "hangul-jamo-composed", "input": "가/x", "output": "가/x"},
    {"name": "chinese", "input": "文档/设计说明.md", "output": "文档/设计说明.md"},
    {"name": "emoji", "input": "🚀/launch 🚀.txt", "output": "🚀/launch 🚀.txt"},
    {"name": "spaces", "input": "a b/c d.txt", "output": "a b/c d.txt"},
    {"name": "case-preserved", "input": "Plan.dwg", "output": "Plan.dwg"},
    {"name": "sharp-s-preserved", "input": "straße/Größe.txt", "output": "straße/Größe.txt"},
    {"name": "html-and-quote-chars", "input": "<&>/\"quoted\".txt", "output": "<&>/\"quoted\".txt"},
    {"name": "dot-prefixed-names", "input": ".hidden/.gitignore", "output": ".hidden/.gitignore"},
    {"name": "dots-inside-names", "input": "..a/b../...", "output": "..a/b../..."},
    {"name": "fullwidth-solidus-is-not-a-separator", "input": "a／b", "output": "a／b"},
    {"name": "c1-control-not-rejected", "input": "a\u0085b", "output": "a\u0085b"},
    {"name": "segment-255-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 255}]}, "output_gen": {"segments": [{"unit": "a", "repeat": 255}]}},
    {"name": "segment-255-bytes-cjk", "input_gen": {"segments": [{"unit": "中", "repeat": 85}]}, "output_gen": {"segments": [{"unit": "中", "repeat": 85}]}},
    {"name": "nfd-381-bytes-is-254-after-nfc", "input_gen": {"segments": [{"unit": "é", "repeat": 127}]}, "output_gen": {"segments": [{"unit": "é", "repeat": 127}]}},
    {"name": "path-4096-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 255, "times": 15}, {"unit": "b", "repeat": 254}, {"unit": "c", "repeat": 1}]}, "output_gen": {"segments": [{"unit": "a", "repeat": 255, "times": 15}, {"unit": "b", "repeat": 254}, {"unit": "c", "repeat": 1}]}},

    {"name": "empty", "input": "", "error": "empty"},
    {"name": "invalid-utf8-ff", "input_hex": "ff", "error": "invalid_utf8"},
    {"name": "invalid-utf8-truncated", "input_hex": "61c3", "error": "invalid_utf8"},
    {"name": "invalid-utf8-overlong-slash", "input_hex": "61c0af62", "error": "invalid_utf8"},
    {"name": "invalid-utf8-surrogate", "input_hex": "eda080", "error": "invalid_utf8"},
    {"name": "absolute", "input": "/etc/passwd", "error": "absolute"},
    {"name": "root-slash", "input": "/", "error": "absolute"},
    {"name": "absolute-wins-over-empty-segment", "input": "/a//b", "error": "absolute"},
    {"name": "backslash", "input": "a\\b", "error": "backslash"},
    {"name": "backslash-unc", "input": "\\\\server\\share", "error": "backslash"},
    {"name": "nul", "input": "a\u0000b", "error": "control_char"},
    {"name": "newline", "input": "a\nb", "error": "control_char"},
    {"name": "tab", "input": "tab\there", "error": "control_char"},
    {"name": "unit-separator", "input": "a\u001f", "error": "control_char"},
    {"name": "del", "input": "del\u007f", "error": "control_char"},
    {"name": "double-slash", "input": "a//b", "error": "empty_segment"},
    {"name": "trailing-slash", "input": "a/", "error": "empty_segment"},
    {"name": "dot", "input": ".", "error": "dot_segment"},
    {"name": "dotdot", "input": "..", "error": "dot_segment"},
    {"name": "dot-inside", "input": "a/./b", "error": "dot_segment"},
    {"name": "dotdot-inside", "input": "a/../b", "error": "dot_segment"},
    {"name": "dotdot-leading", "input": "../a", "error": "dot_segment"},
    {"name": "dotdot-trailing", "input": "a/..", "error": "dot_segment"},
    {"name": "empty-segment-before-dotdot", "input": "a//b/..", "error": "empty_segment"},
    {"name": "segment-256-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 256}]}, "error": "segment_too_long"},
    {"name": "segment-258-bytes-cjk", "input_gen": {"segments": [{"unit": "中", "repeat": 86}]}, "error": "segment_too_long"},
    {"name": "nfd-segment-256-bytes-after-nfc", "input_gen": {"segments": [{"unit": "é", "repeat": 128}]}, "error": "segment_too_long"},
    {"name": "empty-segment-wins-over-length", "input_gen": {"segments": [{"unit": "b", "repeat": 256}, {"unit": "", "repeat": 0}, {"unit": "x", "repeat": 1}]}, "error": "empty_segment"},
    {"name": "path-4097-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 255, "times": 15}, {"unit": "b", "repeat": 255}, {"unit": "c", "repeat": 1}]}, "error": "path_too_long"}
  ],
  "fold": [
    {"input": "Plan.dwg", "fold": "plan.dwg"},
    {"input": "plan.dwg", "fold": "plan.dwg"},
    {"input": "straße", "fold": "strasse"},
    {"input": "STRASSE", "fold": "strasse"},
    {"input": "ẞ", "fold": "ss"},
    {"input": "café", "fold": "café"},
    {"input": "café", "fold": "café"},
    {"input": "CAFÉ", "fold": "café"},
    {"input": "Σ", "fold": "σ"},
    {"input": "ς", "fold": "σ"},
    {"input": "K", "fold": "k"},
    {"input": "ﬁle", "fold": "file"},
    {"input": "İ", "fold": "i̇"},
    {"input": "文档", "fold": "文档"},
    {"input": "🚀", "fold": "🚀"}
  ],
  "siblings": [
    {"name": "distinct", "entries": [{"name": "a", "dir": false}, {"name": "b", "dir": false}, {"name": "c", "dir": true}]},
    {"name": "case-conflict", "entries": [{"name": "Plan.dwg", "dir": false}, {"name": "plan.dwg", "dir": false}], "error": "case_conflict"},
    {"name": "sharp-s-vs-ss", "entries": [{"name": "straße", "dir": false}, {"name": "STRASSE", "dir": false}], "error": "case_conflict"},
    {"name": "file-and-dir-same-name", "entries": [{"name": "docs", "dir": true}, {"name": "docs", "dir": false}], "error": "file_dir_conflict"},
    {"name": "file-and-dir-differ-in-case", "entries": [{"name": "Docs", "dir": false}, {"name": "docs", "dir": true}], "error": "case_conflict"},
    {"name": "duplicate-file", "entries": [{"name": "a", "dir": false}, {"name": "a", "dir": false}], "error": "duplicate"},
    {"name": "final-sigma", "entries": [{"name": "σ", "dir": false}, {"name": "ς", "dir": false}], "error": "case_conflict"},
    {"name": "ligature-fi", "entries": [{"name": "ﬁle", "dir": false}, {"name": "file", "dir": false}], "error": "case_conflict"},
    {"name": "kelvin-sign", "entries": [{"name": "K", "dir": false}, {"name": "k", "dir": false}], "error": "case_conflict"},
    {"name": "dotted-capital-i-vs-i", "entries": [{"name": "İ", "dir": false}, {"name": "i", "dir": false}]}
  ],
  "branch_names": [
    {"input": "main", "output": "main"},
    {"input": "release-1.0", "output": "release-1.0"},
    {"input": "功能分支", "output": "功能分支"},
    {"input": "café", "output": "café"},
    {"input": " spaced ", "output": " spaced "},
    {"input_gen": {"segments": [{"unit": "a", "repeat": 255}]}, "output_gen": {"segments": [{"unit": "a", "repeat": 255}]}},
    {"input": "feature/x", "error": "contains_slash"},
    {"input": "workstreams/01J0000000000000000000000/main", "error": "contains_slash"},
    {"input": "", "error": "empty"},
    {"input": ".", "error": "dot_segment"},
    {"input": "..", "error": "dot_segment"},
    {"input": "a\\b", "error": "backslash"},
    {"input": "tab\t", "error": "control_char"},
    {"input_hex": "6d61696eff", "error": "invalid_utf8"},
    {"input_gen": {"segments": [{"unit": "a", "repeat": 256}]}, "error": "segment_too_long"}
  ]
}
