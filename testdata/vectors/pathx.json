    {"name": "order-characters-before-nfc", "input": "cafe\u0301\u0378", "error": "unassigned_char"},
    {"name": "double-slash", "input": "a//b", "error": "empty_segment"},
    {"name": "trailing-slash", "input": "a/", "error": "empty_segment"},
    {"name": "dot", "input": ".", "error": "dot_segment"},
    {"name": "dotdot", "input": "..", "error": "dot_segment"},
    {"name": "dot-inside", "input": "a/./b", "error": "dot_segment"},
    {"name": "dotdot-inside", "input": "a/../b", "error": "dot_segment"},
    {"name": "dotdot-leading", "input": "../a", "error": "dot_segment"},
    {"name": "dotdot-trailing", "input": "a/..", "error": "dot_segment"},
    {"name": "empty-segment-before-dotdot", "input": "a//b/..", "error": "empty_segment"},
    {"name": "segment-256-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 256}]}, "error": "segment_too_long"},
    {"name": "segment-258-bytes-cjk", "input_gen": {"segments": [{"unit": "中", "repeat": 86}]}, "error": "segment_too_long"},
    {"name": "nfd-segment-256-bytes-after-nfc", "input_gen": {"segments": [{"unit": "é", "repeat": 128}]}, "error": "segment_too_long"},
    {"name": "empty-segment-wins-over-length", "input_gen": {"segments": [{"unit": "b", "repeat": 256}, {"unit": "", "repeat": 0}, {"unit": "x", "repeat": 1}]}, "error": "empty_segment"},
    {"name": "path-4097-bytes", "input_gen": {"segments": [{"unit": "a", "repeat": 255, "times": 15}, {"unit": "b", "repeat": 255}, {"unit": "c", "repeat": 1}]}, "error": "path_too_long"}
  ],
