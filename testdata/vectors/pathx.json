    {"name": "arabic-letter-mark-u061c", "input": "a\u061cb", "error": "disallowed_char"},
    {"name": "zero-width-space-u200b", "input": "a\u200bb", "error": "disallowed_char"},
    {"name": "word-joiner-u2060", "input": "a\u2060b", "error": "disallowed_char"},
    {"name": "byte-order-mark-ufeff", "input": "\ufeffa.txt", "error": "disallowed_char"},
    {"name": "unassigned-u0378", "input": "a\u0378", "error": "unassigned_char"},
    {"name": "unassigned-plane4-u40000", "input": "a\ud8c0\udc00", "error": "unassigned_char"},
    {"name": "noncharacter-uffff", "input": "a\uffff", "error": "unassigned_char"},
    {"name": "noncharacter-ufdd0", "input": "a\ufdd0", "error": "unassigned_char"},
    {"name": "order-absolute-before-characters", "input": "/\u202e", "error": "absolute"},
    {"name": "order-first-character-wins-disallowed", "input": "a\u202eb\\c", "error": "disallowed_char"},
    {"name": "order-first-character-wins-backslash", "input": "a\\b\u202ec", "error": "backslash"},
    {"name": "order-first-character-wins-unassigned", "input": "\u0378\u0085", "error": "unassigned_char"},
